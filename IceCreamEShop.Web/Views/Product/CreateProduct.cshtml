@using IceCreamEShop.Web.ViewModels.Product
@{
    ViewData["Title"] = "新商品";
}
@model CreateProductViewModel

<form id="productForm" method="post" asp-controller="Product" asp-action="CreateProduct" enctype="multipart/form-data">
    <div class="form-group">
        <label>商品名稱: </label>
        <br>
        <input asp-for="ProductName" class="w-25 form-control">
        <br>
        <span asp-validation-for="ProductName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ProductPic">商品圖片: </label>
        <br>
        <input type="file" asp-for="ProductPic" class="w-25 form-control">
        <br>
        <span asp-validation-for="ProductPic" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>商品類別: </label>
        <br>
        <input asp-for="Category" class="w-25 form-control">
        <br>
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>商品描述: </label>
        <br>
        <textarea asp-for="ProductDescription" class="form-control" rows="6"></textarea>
        <br>
        <span asp-validation-for="ProductDescription" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>商品價格: </label>
        <br>
        <input asp-for="ProductPrice" class="w-25 form-control">
        <br>
        <span asp-validation-for="ProductPrice" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>商品數量: </label>
        <br>
        <input asp-for="Quantity" class="w-25 form-control">
        <br>
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>
    <div class="form-group form-check">
        <input type="checkbox" asp-for="IsPublished" class="form-check-input">
        <label asp-for="IsPublished" class="form-check-label">是否上架</label>
        <span asp-validation-for="IsPublished" class="text-danger"></span>
    </div>
    <button type="submit">新增商品</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}